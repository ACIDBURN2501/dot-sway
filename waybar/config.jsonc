// Waybar layout for the Sway desktop.
//
//   Left:    workspaces, sway mode
//   Center:  brightness, volume, media, theme, DND, bluetooth, network, power
//   Right:   tray, battery, clock
//
// Three modules under custom/* shell out to scripts in waybar/modules/
// for logic that has no native equivalent (DDC/CI brightness cache,
// theme flag, DND flag).
//
// Dropdown menus (audio, media, power) are native Waybar menus: XML in
// waybar/menus/, styled via the `menu`/`menuitem` selectors in style.css.
// Toggles (brightness, theme, DND, stay-awake) stay plain clicks, and
// network/bluetooth keep their wofi popups because those lists are
// dynamic (see scripts/quick-menu.sh).
{
  "layer": "top",
  "position": "top",
  "height": 32,
  // 0 on purpose: the .module pill framework in style.css owns the gaps
  // (8px padding per pill side -> uniform 16px between all pills).
  "spacing": 0,

  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["custom/brightness", "pulseaudio", "mpris", "custom/theme", "custom/dnd", "custom/stay-awake", "bluetooth", "network", "custom/power"],
  "modules-right": ["tray", "battery", "clock"],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },

  "battery": {
    "states": {
      "warning": 50,
      "critical": 20
    },
    "format": "{icon} {time}",
    "format-charging": "󱟠 {time}",
    "format-plugged": "🔌",
    "format-full": "🔌",
    "format-time": "{H}h {M}m",
    "format-icons": ["󰂎", "󱟞", "󱟞", "󱟞", "󱟞"],
    "tooltip-format": "{capacity}% — {timeTo}"
  },

  "custom/brightness": {
    "exec": "$HOME/.config/sway/waybar/modules/brightness.sh",
    "interval": 2,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 ",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    // Left-click opens the dropdown; the command and the menu fire on the
    // same click, so the old wofi on-click was dropped, not kept. The
    // devices item inside delegates to the same script ($super+Ctrl+a too).
    "menu": "on-click",
    "menu-file": "$HOME/.config/sway/waybar/menus/audio.xml",
    "menu-actions": {
      "mute-output": "$HOME/.config/sway/scripts/volume-control.sh mute",
      "mute-mic": "$HOME/.config/sway/scripts/volume-control.sh mic-mute",
      "devices": "$HOME/.config/sway/scripts/quick-menu.sh audio"
    },
    "on-click-right": "$HOME/.config/sway/scripts/volume-control.sh mute",
    "on-scroll-up": "$HOME/.config/sway/scripts/volume-control.sh up",
    "on-scroll-down": "$HOME/.config/sway/scripts/volume-control.sh down"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": {
      "default": "󰎈"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "dynamic-len": 40,
    "tooltip-format": "{player} ({status})\n{title} — {artist}\n{album}",
    "menu": "on-click",
    "menu-file": "$HOME/.config/sway/waybar/menus/mpris.xml",
    "menu-actions": {
      "play-pause": "playerctl play-pause",
      "next": "playerctl next",
      "previous": "playerctl previous"
    },
    // Empty on-click: routes the click to the menu handler and suppresses
    // the module's built-in left-click play/pause (middle/right keep their
    // built-in previous/next).
    "on-click": ""
  },

  "custom/theme": {
    "exec": "$HOME/.config/sway/waybar/modules/theme.sh",
    "interval": 5,
    "on-click": "$HOME/.config/sway/scripts/toggle_theme.sh",
    "tooltip-format": "Click to toggle theme"
  },

  "custom/dnd": {
    "exec": "$HOME/.config/sway/waybar/modules/dnd.sh",
    "interval": 2,
    "on-click": "$HOME/.config/sway/scripts/toggle-mako-dnd.sh",
    "tooltip-format": "Click to toggle Do Not Disturb"
  },

  "custom/stay-awake": {
    "exec": "$HOME/.config/sway/waybar/modules/stay-awake.sh",
    "interval": 2,
    "on-click": "$HOME/.config/sway/scripts/toggle-stay-awake.sh",
    "tooltip-format": "Stay awake: idle lock and screen-off suspended. Click to toggle."
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "$HOME/.config/sway/scripts/quick-menu.sh bluetooth",
    "on-click-right": "$HOME/.config/sway/scripts/toggle-bluetooth.sh"
  },

  "custom/power": {
    // Static pill (lightning bolt ⚡, U+26A1) — the script prints the icon
    // once ("interval": "once").
    // Left-click opens the power dropdown, a parallel definition of
    // extra/wofi/wofi-power.sh ($super+Ctrl+p keeps the wofi path).
    "exec": "$HOME/.config/sway/waybar/modules/power.sh",
    "interval": "once",
    "menu": "on-click",
    "menu-file": "$HOME/.config/sway/waybar/menus/power.xml",
    "menu-actions": {
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate",
      "logout": "swaymsg exit"
    },
    "tooltip-format": "Click for power actions"
  },

  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "format-disabled": "",
    "tooltip-format-wifi": "{essid} — {ipaddr}\n↓ {bandwidthDownBits} ↑ {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname} — {ipaddr}",
    "on-click": "$HOME/.config/sway/scripts/quick-menu.sh network",
    "on-click-right": "$HOME/.config/sway/scripts/network-tui.sh"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><big>{:%Y-%m-%d}</big>\n\n{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "today": "<span color='#5294e2'><b>{}</b></span>"
      }
    }
  }
}
