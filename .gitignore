# Machine-local monitor profiles — copy scripts/monitor-profiles.example.sh
# to this path and edit for your hardware.
scripts/monitor-profiles.local.sh

# Per-machine settings — copy host.env.example to this path. Compose key,
# wallpaper pool, idle timeouts, monitor overrides: not committed.
host.env
.theme_state
 
# Wallpaper rotation: track the folder (via .gitkeep) and the bundled
# public-domain wallpaper, but not the rest of the pool.
# Never commit the active wp.png symlink — rotate-wallpaper.sh manages it.
# host.env's WALLPAPER_DIR optionally points rotation at an external folder.
images/wallpapers/*
!images/wallpapers/.gitkeep
!images/wallpapers/frederic-church-parthenon.jpg
images/wp.png

# Waybar active palette symlink — managed by toggle_theme.sh, points at
# waybar/colors-{dark,light}.css depending on current theme state.
waybar/colors.css

# Machine-local event hook overlay — per-machine automation lives here;
# tracked samples under hooks/ stay generic (docs/hooks.md).
hooks.local/

# archinstall JSON pair — the real files hold a password hash and
# machine-specific details; only the .example forms are committed.
bootstrap/archinstall/user_credentials.json
bootstrap/archinstall/user_configuration.json
