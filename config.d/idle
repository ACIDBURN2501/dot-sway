### Idle handling
# swayidle: lock after 10 minutes idle, power the display off after 15,
# and always lock before suspend. Timings are user-configurable in
# host.env (LOCK_TIMEOUT / SCREEN_OFF_TIMEOUT, seconds; 0 disables a
# timeout — copy host.env.example) — edit, then run
# scripts/idle-manager.sh again to apply without a reload.
# Stay awake: $super+Ctrl+s (the ☕ bar icon shows while it is active;
# idle lock and screen-off are suspended, locking before a manual
# suspend still happens).
exec sh -c 'command -v swayidle >/dev/null && exec $HOME/.config/sway/scripts/idle-manager.sh'
