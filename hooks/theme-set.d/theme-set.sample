#!/bin/sh
# Example theme-set hook (non-executable by design).
#
# Fires: after every theme flip, as the last side effect of
# scripts/toggle_theme.sh (after waybar repaint, kitty, mako, and the
# flag write). `init` does not fire it.
# Receives: the event name ($1 = "theme-set"). Use
# `bash scripts/toggle.sh get theme` for the new theme value, or
# `scripts/toggle_theme.sh get` to print it.
# Exit codes: a non-zero exit is logged by scripts/hooks.sh and skipped;
# the remaining hooks still run.
#
# To activate:
#   cp theme-set.sample myhook.sh && chmod +x myhook.sh

exit 0
