# Example power-unplugged hook (non-executable by design).
#
# Fires: once per transition, when the AC is disconnected — the UPower
# state moves from charging to discharging (scripts/power-events.sh, 30s
# poll).
# Receives: the event name ($1 = "power-unplugged").
# Exit codes: a non-zero exit is logged by scripts/hooks.sh and skipped;
# the remaining hooks still run.
#
# To activate:
#   cp power-unplugged.sample myhook.sh && chmod +x myhook.sh

exit 0
