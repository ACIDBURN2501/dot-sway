# Example battery-low hook (non-executable by design).
#
# Fires: once per discharge episode, when the battery reaches 20% while
# unplugged (scripts/power-events.sh, 30s poll). Does not repeat while
# the battery stays low, and re-arms on the next charge.
# Receives: the event name ($1 = "battery-low").
# Exit codes: a non-zero exit is logged by scripts/hooks.sh and skipped;
# the remaining hooks still run.
#
# To activate:
#   cp battery-low.sample myhook.sh && chmod +x myhook.sh

exit 0
