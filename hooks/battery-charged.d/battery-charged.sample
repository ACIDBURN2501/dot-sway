# Example battery-charged hook (non-executable by design).
#
# Fires: once per charge episode, when the battery reaches "fully-charged"
# (scripts/power-events.sh, 30s poll). Does not repeat while the battery
# stays full, and re-arms on the next discharge.
# Receives: the event name ($1 = "battery-charged").
# Exit codes: a non-zero exit is logged by scripts/hooks.sh and skipped;
# the remaining hooks still run.
#
# To activate:
#   cp battery-charged.sample myhook.sh && chmod +x myhook.sh

exit 0
