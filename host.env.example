# Per-machine settings for this Sway desktop. Copy to host.env (gitignored)
# and edit. Every key is optional; empty or absent means the built-in default.
#
# This file is sourced as bash by scripts/lib/host-env.sh, so quote values
# that contain spaces. Precedence: a non-empty environment variable beats the
# value here, which beats the built-in default.
#
# Two per-machine mechanisms deliberately stay out of this file:
#   scripts/monitor-profiles.local.sh: per-monitor hotplug profiles (a bash
#     function, not key-values; copy scripts/monitor-profiles.example.sh)
#   hooks.local/: per-machine event hooks (a directory of executables)

# Compose key (xkb option; see man 7 xkeyboard-config). Rendered into a sway
# include snippet by scripts/host-env.sh at session start. After editing:
# run scripts/host-env.sh, then `swaymsg reload`.
# Common values: compose:menu (default) compose:ralt compose:rctrl
#                compose:caps compose:lwin compose:rwin
COMPOSE_KEY=

# Wallpaper rotation pool. Empty = the in-repo images/wallpapers/.
# Must be an existing directory or the default stands (with a warning).
#WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
WALLPAPER_DIR=

# Idle timeouts in seconds (0 disables). Read by scripts/idle-manager.sh;
# run it again after editing; no sway reload needed.
LOCK_TIMEOUT=600
SCREEN_OFF_TIMEOUT=900

# External-monitor overrides for scripts/monitor-hotplug.sh. Empty = use the
# per-monitor profile (scripts/monitor-profiles.local.sh) or the fallback.
# Applies on the next hotplug event or `swaymsg reload` (the daemon is
# exec_always, so a reload restarts it).
DOTSWAY_EXT_RES=              # e.g. 3840x2160@120Hz
DOTSWAY_EXT_SCALE=            # e.g. 1.25
DOTSWAY_EXT_ADAPTIVE_SYNC=    # on | off
DOTSWAY_INTERNAL_OUTPUT=      # e.g. eDP-1; empty = auto-detect

# Path to a swayi checkout (the AI-usage pill). Empty = the pill hides.
#SWAYI_DIR="$HOME/Workspace/you/swayi"
SWAYI_DIR=
